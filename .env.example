# ============ 服务 ============
PORT=8899

# ============ 数据库 ============
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=abai66

# ============ 大模型（OpenAI 兼容接口） ============
# 任何兼容 POST /v1/chat/completions 的服务都可以
LLM_BASE=https://your-llm-api.example.com
LLM_KEY=
LLM_MODEL=deepseek-v4.1-flash

# ============ 通信加密密钥（可选） ============
# 留空使用内置默认值。生产环境请填写。
# 生成：node -e "import('./lib/crypto.mjs').then(m=>console.log(m.generateKeyPair()))"
CRYPTO_IKM=
CRYPTO_SALT=

# ============ 后台令牌 ============
# 后台 /admin 登录用，务必修改
ADMIN_TOKEN=change-me-please

# ============ 素材生成（仅 tools/generate-assets.mjs 使用） ============
IMAGE_API_BASE=https://your-image-api.example.com
IMAGE_API_KEY=
